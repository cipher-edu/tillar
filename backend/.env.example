# Nusxa: .env  (cPanel da backend papkasiga qo‘ying)
# HECH QACHON .env ni git ga commit qilmang!

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=bu-yerga-uzun-tasodifiy-kalit-yozing-kamida-50-belgi

# Verulg bilan
DJANGO_ALLOWED_HOSTS=sizning-domen.uz,www.sizning-domen.uz,api.sizning-domen.uz

# Frontend manzillari (HTTPS)
DJANGO_CORS_ORIGINS=https://sizning-domen.uz,https://www.sizning-domen.uz
DJANGO_CSRF_TRUSTED=https://sizning-domen.uz,https://www.sizning-domen.uz,https://api.sizning-domen.uz

# Cookie HTTPS da
DJANGO_COOKIE_SECURE=1
# Proxy orqali HTTPS bo‘lsa 1; to‘g‘ridan SSL bo‘lmasa 0
DJANGO_SSL_REDIRECT=0

# sqlite (default) yoki mysql
DJANGO_DB_ENGINE=sqlite
# DJANGO_DB_ENGINE=mysql
# DJANGO_DB_NAME=cpanel_db_name
# DJANGO_DB_USER=cpanel_db_user
# DJANGO_DB_PASSWORD=***
# DJANGO_DB_HOST=localhost
# DJANGO_DB_PORT=3306
